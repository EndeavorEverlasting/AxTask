{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "axtask.agent-routing.route-decision.v1",
  "title": "Route Decision",
  "type": "object",
  "description": "Deterministic routing decision combining task demand and executor capability. Emits exact prompt constraints required to reduce the leap.",
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "decisionId": { "type": "string", "description": "Unique identifier for this routing decision" },
    "taskDemand": {
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "demandLevel": { "type": "string", "enum": ["bounded-deterministic", "bounded-investigation", "architecture-reconciliation", "protected-runtime-judgment"] },
        "reasoningLeap": { "type": "string", "enum": ["none", "low", "medium", "high", "critical"] }
      },
      "required": ["taskId", "demandLevel", "reasoningLeap"]
    },
    "executor": {
      "type": "object",
      "properties": {
        "executorId": { "type": "string" },
        "maxAllowedDemand": { "type": "string", "enum": ["bounded-deterministic", "bounded-investigation", "architecture-reconciliation", "protected-runtime-judgment"] },
        "lane": { "type": "string", "enum": ["deterministic-repair", "investigation", "architecture", "runtime-certification", "blocked"] }
      },
      "required": ["executorId", "maxAllowedDemand", "lane"]
    },
    "decision": {
      "type": "string",
      "enum": ["allow", "downgrade", "block", "escalate"],
      "description": "Routing outcome"
    },
    "allowedLane": {
      "type": "string",
      "enum": ["deterministic-repair", "investigation", "architecture", "runtime-certification"],
      "description": "The lane actually assigned (may be lower than requested)"
    },
    "requiredConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["owned-files", "forbidden-files", "exact-transformation", "binary-assertions", "validation-order", "stop-conditions"] },
          "description": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "enforcement": { "type": "string", "enum": ["pre-flight", "post-flight", "continuous"] }
        },
        "required": ["type", "description", "enforcement"]
      },
      "description": "Exact prompt constraints required to reduce the reasoning leap"
    },
    "blockOrDowngradeReason": {
      "type": "string",
      "description": "Human-readable reason when decision is 'block', 'downgrade', or 'escalate'"
    },
    "factoringGuidance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "reducesTo": { "type": "string", "enum": ["bounded-deterministic", "bounded-investigation"] },
          "mechanicalCheck": { "type": "string" }
        },
        "required": ["description", "reducesTo", "mechanicalCheck"]
      },
      "description": "How to factor the task to lower demand if blocked"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time", "description": "Decision expires when executor evidence or task classification changes" }
  },
  "required": ["schemaVersion", "decisionId", "taskDemand", "executor", "decision", "allowedLane", "requiredConstraints", "createdAt", "validUntil"],
  "additionalProperties": false
}