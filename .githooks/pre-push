#!/usr/bin/env sh
set -eu

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is required to run AxTask pre-push checks." >&2
  exit 1
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "npx is required to run AxTask AI harness contract tests." >&2
  exit 1
fi

node tools/security/check_node_provenance.mjs
node tools/security/check_node_runtime.mjs
node tools/security/check_no_axios.mjs
node scripts/ai-harness/validate-authority.mjs
node scripts/ai-harness/validate-harness.mjs
node scripts/ai-harness/validate-harness-infrastructure.mjs
node scripts/ai-harness/validate-progressive-disclosure.mjs
node scripts/ai-harness/validate-local-cert-harness.mjs
node scripts/ai-harness/validate-repo-location-recovery.mjs
node scripts/ai-harness/validate-work-queue.mjs
node scripts/ai-harness/validate-stateful-architecture.mjs
node scripts/ai-harness/validate-log-retention.mjs
node scripts/ai-harness/validate-agent-workspaces.mjs
node scripts/ai-harness/workspaces.mjs doctor --strict-current
npx --no-install vitest run \
  server/ai-harness/authority-contract.test.ts \
  server/ai-harness/harness-contract.test.ts \
  server/ai-harness/deployment-certification-contract.test.ts \
  server/ai-harness/validator-selection-contract.test.ts \
  server/ai-harness/harness-infrastructure-contract.test.ts \
  server/ai-harness/progressive-disclosure-contract.test.ts \
  server/ai-harness/local-production-certification-contract.test.ts \
  server/ai-harness/contract-impact-contract.test.ts \
  server/ai-harness/work-queue-contract.test.ts \
  server/ai-harness/stateful-architecture-contract.test.ts \
  server/ai-harness/log-retention-harness-contract.test.ts \
  server/ai-harness/agent-workspace-contract.test.ts
