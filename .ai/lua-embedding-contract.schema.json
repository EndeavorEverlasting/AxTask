{
  "schemaVersion": 1,
  "authorityRef": "axtask.agent-authority.v1",
  "schemaId": "axtask.lua-embedding-contract.schema.v1",
  "type": "object",
  "required": ["contractId","mission","adoption","architecture","stateIsolation","errorHandling","execution","types","sandbox","semantics","aiAuditability","implementationGates","proof","forbidden"],
  "properties": {
    "contractId":{"type":"string","enum":["axtask.lua-embedding.v1"]},
    "mission":{"type":"string"},
    "adoption":{"type":"object","required":["phase","productMutationAuthorized","runtimeImplementation","runtimeAdapter","providerSelected","note","harnessOnlyMutationPolicy"],"properties":{"harnessOnlyMutationPolicy":{"type":"object","required":["allowedChangedPathPatterns","forbiddenFileExtensions","forbiddenDependencyNamePattern","forbiddenProductMarkers","rule"],"properties":{"allowedChangedPathPatterns":{"type":"array","minItems":6,"items":{"type":"string"}},"forbiddenFileExtensions":{"type":"array","minItems":1,"items":{"type":"string"}},"forbiddenDependencyNamePattern":{"type":"string"},"forbiddenProductMarkers":{"type":"array","minItems":5,"items":{"type":"string"}},"rule":{"type":"string"}}}}},
    "architecture":{"type":"object","required":["integrationMode","hostControlsMainLoop","scriptControlsMainLoop","hostOwnsCriticalState","performancePartition"]},
    "stateIsolation":{"type":"object","required":["independentVmStatesRequired","sharedMutableVmStateDefault","resetByDestroyingState","closeStateRequired","hostMemoryUnaffectedByStateDestroyRequired"]},
    "errorHandling":{"type":"object","required":["scriptMayRaise","hostCatchRequired","cleanupBeforePropagationRequired","rollbackOwnedByHost","uncaughtScriptErrorMayTerminateHost"]},
    "execution":{"type":"object","required":["bytecodePolicy","interpreterBaseline","jitDefaultEnabled","jitAdoptionRequires","hiddenCompilationMagicAllowed"]},
    "types":{"type":"object","required":["languageTyping","runtimeBoundaryChecksRequired","internalTypeDisciplineRequired","hostBoundaryContractsRequired","implicitCrossBoundaryCoercion"]},
    "sandbox":{"type":"object","required":["exposureMode","capabilityManifest","defaultHostFunctions","defaultDeniedLibraries","wildcardExposureAllowed","filesystemAccessDefault","networkAccessDefault","processAccessDefault","dynamicCodeLoadingDefault"]},
    "semantics":{"type":"object","required":["luaSequenceIndexBase","hostIndexTranslation","featurePolicy","hostFirstRule"]},
    "aiAuditability":{"type":"object","required":["readableNonMagicalSnippetsRequired","hiddenHostLookupAllowed","generatedSnippetMustDeclareCapabilities","generatedSnippetMustBeReviewableWithoutRuntimeIntrospection"]},
    "implementationGates":{"type":"array","minItems":8,"items":{"type":"object","required":["id","requirement","proof"]}},
    "proof":{"type":"object","required":["currentCeiling","harnessCanProve","harnessCannotProve"]},
    "forbidden":{"type":"array","minItems":8,"items":{"type":"string"}}
  }
}
