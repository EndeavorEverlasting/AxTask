{
  "schemaVersion": 1,
  "authorityRef": "axtask.agent-authority.v1",
  "schemaId": "axtask.stateful-surface-ledger.v1",
  "required": [
    "ledgerId",
    "mission",
    "decisionPolicy",
    "surfaces"
  ],
  "properties": {
    "ledgerId": {
      "type": "string"
    },
    "mission": {
      "type": "string"
    },
    "decisionPolicy": {
      "type": "object",
      "required": [
        "target",
        "defaultDisposition",
        "migrationAuthorizationRule",
        "proofRule"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "defaultDisposition": {
          "type": "string",
          "enum": [
            "keep"
          ]
        },
        "migrationAuthorizationRule": {
          "type": "string"
        },
        "proofRule": {
          "type": "string"
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "owner",
          "files",
          "currentResponsibility",
          "stateHeld",
          "stateLifetime",
          "persistenceMechanism",
          "consumers",
          "processAffinity",
          "longLivedConnection",
          "filesystemDependency",
          "schedulingDependency",
          "deploymentCoupling",
          "invariants",
          "stableContracts",
          "evidence",
          "disposition",
          "decisionStatus",
          "rationale",
          "migrationSeam",
          "prerequisites",
          "forbiddenChanges",
          "validators",
          "proofCeiling",
          "collisionPaths"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "request-runtime",
              "persistence",
              "auth-session",
              "background-work",
              "filesystem",
              "deployment",
              "cache-queue",
              "integration"
            ]
          },
          "owner": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "currentResponsibility": {
            "type": "string"
          },
          "stateHeld": {
            "type": "string"
          },
          "stateLifetime": {
            "type": "string"
          },
          "persistenceMechanism": {
            "type": "string"
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "processAffinity": {
            "type": "string",
            "enum": [
              "required",
              "not-required",
              "unknown"
            ]
          },
          "longLivedConnection": {
            "type": "string",
            "enum": [
              "required",
              "not-required",
              "unknown"
            ]
          },
          "filesystemDependency": {
            "type": "string",
            "enum": [
              "required",
              "not-required",
              "unknown"
            ]
          },
          "schedulingDependency": {
            "type": "string",
            "enum": [
              "required",
              "not-required",
              "unknown"
            ]
          },
          "deploymentCoupling": {
            "type": "string"
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "stableContracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "keep",
              "replace",
              "externalize",
              "delete"
            ]
          },
          "decisionStatus": {
            "type": "string",
            "enum": [
              "provisional",
              "approved"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "migrationSeam": {
            "type": "string"
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbiddenChanges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "validators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "proofCeiling": {
            "type": "string",
            "enum": [
              "contract",
              "harness",
              "static-test",
              "build",
              "launcher-browser",
              "command-ack",
              "behavior-observed",
              "live-runtime"
            ]
          },
          "collisionPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
