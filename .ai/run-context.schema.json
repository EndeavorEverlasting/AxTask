{
  "schemaVersion": 1,
  "authorityRef": "axtask.agent-authority.v1",
  "schemaId": "axtask.run-context.v1",
  "required": [
    "workflowId",
    "ownerRole",
    "activationReason",
    "repoRoot",
    "branch",
    "head",
    "baseRef",
    "environmentClass",
    "candidateSha",
    "ownedScope",
    "forbiddenScope",
    "expectedArtifacts",
    "likelyFiles",
    "collisionFiles",
    "selectedSkills",
    "selectedCapabilities",
    "selectedTriggers",
    "preconditions",
    "forbiddenConditions",
    "targetedValidators",
    "validation",
    "requiredProofLevels",
    "attainedProofLevels",
    "proofCeiling"
  ],
  "properties": {
    "workflowId": {"type":"string"},
    "ownerRole": {"type":"string"},
    "activationReason": {"type":"string"},
    "repoRoot": {"type":"string"},
    "branch": {"type":"string"},
    "head": {"type":"string"},
    "baseRef": {"type":"string"},
    "environmentClass": {"type":"string", "enum": ["local", "staging", "live"]},
    "candidateSha": {"type":"string"},
    "ownedScope": {"type":"array", "items":"string"},
    "forbiddenScope": {"type":"array", "items":"string"},
    "expectedArtifacts": {"type":"array", "items":"string"},
    "likelyFiles": {"type":"array", "items":"string"},
    "collisionFiles": {"type":"array", "items":"string"},
    "selectedSkills": {"type":"array", "items":"string"},
    "selectedCapabilities": {"type":"array", "items":"string"},
    "selectedTriggers": {"type":"array", "items":"string"},
    "preconditions": {"type":"array", "items":"string"},
    "forbiddenConditions": {"type":"array", "items":"string"},
    "targetedValidators": {"type":"array", "items":"string"},
    "validation": {"type":"array", "items":"string"},
    "requiredProofLevels": {"type":"array", "items":"string"},
    "attainedProofLevels": {"type":"array", "items":"string"},
    "proofCeiling": {"type":"string"},
    "knownDirt": {"type":"array", "items":"string"},
    "openPrCollisions": {"type":"array", "items":"string"}
  },
  "runtimePolicy": {
    "tracked": false,
    "defaultDirectory": ".ai/runs",
    "secretsAllowed": false,
    "rawLogsAllowed": false
  }
}
