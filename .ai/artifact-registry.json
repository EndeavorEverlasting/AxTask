{
  "schemaVersion": 1,
  "authorityRef": "axtask.agent-authority.v1",
  "registryId": "axtask.artifacts.v1",
  "artifacts": [
    {
      "id": "run-context",
      "pathPattern": ".ai/runs/<run-id>/context.json",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.repository-intake.v1",
      "generation": "Create JSON matching .ai/run-context.schema.json before mutation.",
      "namingConvention": "<run-id>/context.json",
      "validator": "node scripts/ai-harness/validate-run-context.mjs <path>"
    },
    {
      "id": "repo-snapshot",
      "pathPattern": ".ai/runs/<run-id>/repo-snapshot.json",
      "tracked": false,
      "sanitized": true,
      "producer": "repository-inspection",
      "generation": "node scripts/ai-harness/inspect-repo.mjs --output <path>",
      "namingConvention": "<run-id>/repo-snapshot.json"
    },
    {
      "id": "validator-plan",
      "pathPattern": ".ai/runs/<run-id>/validator-plan.json",
      "tracked": false,
      "sanitized": true,
      "producer": "validator-selection",
      "generation": "node scripts/ai-harness/select-validators.mjs --context <context> --output <path>",
      "namingConvention": "<run-id>/validator-plan.json"
    },
    {
      "id": "collision-ledger",
      "pathPattern": ".ai/runs/<run-id>/collision-ledger.json",
      "tracked": false,
      "sanitized": true,
      "producer": "pr-collision-inspection",
      "generation": "node scripts/ai-harness/inspect-pr-collisions.mjs --output <path>",
      "namingConvention": "<run-id>/collision-ledger.json"
    },
    {
      "id": "contract-impact",
      "pathPattern": ".ai/runs/<run-id>/contract-impact.json",
      "tracked": false,
      "sanitized": true,
      "producer": "contract-impact-inspection",
      "generation": "node scripts/ai-harness/inspect-contract-impact.mjs --output <path>",
      "namingConvention": "<run-id>/contract-impact.json"
    },
    {
      "id": "runtime-proof",
      "pathPattern": ".ai/runs/<run-id>/runtime-proof.json",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.local-deployment-certification.v1",
      "generation": "Create JSON matching .ai/runtime-proof.schema.json from sanitized commands and observations.",
      "namingConvention": "<run-id>/runtime-proof.json",
      "validator": "node scripts/ai-harness/validate-runtime-proof.mjs <path>"
    },
    {
      "id": "local-cert-report",
      "pathPattern": ".ai/runs/<run-id>/local-cert-report.md",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.local-deployment-certification.v1",
      "generation": "Generated beside runtime-proof.json by scripts/deploy/run-local-cert.mjs.",
      "namingConvention": "<run-id>/local-cert-report.md"
    },
    {
      "id": "failure-report",
      "pathPattern": ".ai/runs/<run-id>/failure-report.md",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.failure-recovery.v1",
      "generation": "Render .ai/reports/failure-report-template.md with the exact failing command, classification, bounded attempts, and next action.",
      "namingConvention": "<run-id>/failure-report.md",
      "template": ".ai/reports/failure-report-template.md"
    },
    {
      "id": "operator-report",
      "pathPattern": ".ai/runs/<run-id>/operator-report.md",
      "tracked": false,
      "sanitized": true,
      "producer": "registered workflow",
      "generation": "Render .ai/reports/operator-report-template.md at workflow closeout.",
      "namingConvention": "<run-id>/operator-report.md",
      "template": ".ai/reports/operator-report-template.md"
    },
    {
      "id": "log-retention-proof",
      "pathPattern": ".ai/runs/<run-id>/log-retention-proof.json",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.log-retention-capacity-defense.v1",
      "generation": "node scripts/ai-harness/validate-log-retention.mjs --json > <path>",
      "namingConvention": "<run-id>/log-retention-proof.json",
      "validator": "node scripts/ai-harness/validate-log-retention.mjs"
    },
    {
      "id": "log-retention-report",
      "pathPattern": ".ai/runs/<run-id>/log-retention-report.md",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.log-retention-capacity-defense.v1",
      "generation": "Render .ai/reports/log-retention-report-template.md after repository validation and any separately authorized live retention check.",
      "namingConvention": "<run-id>/log-retention-report.md",
      "template": ".ai/reports/log-retention-report-template.md"
    },
    {
      "id": "final-handoff",
      "pathPattern": ".ai/runs/<run-id>/final-handoff.md",
      "tracked": false,
      "sanitized": true,
      "producer": "registered workflow",
      "generation": "Compress durable facts into .ai/handoff/final-handoff-template.md.",
      "namingConvention": "<run-id>/final-handoff.md",
      "template": ".ai/handoff/final-handoff-template.md"
    },
    {
      "id": "release-evidence",
      "pathPattern": "docs/releases/YYYY-MM-DD-<slug>.md",
      "tracked": true,
      "sanitized": true,
      "producer": "release workflow",
      "generation": "Create one sanitized release note and validate it with npm run release:check.",
      "namingConvention": "YYYY-MM-DD-<lowercase-kebab-case>.md"
    },
    {
      "id": "prompt",
      "pathPattern": ".ai/generated/prompts/<run-id>-<slug>.md",
      "tracked": false,
      "sanitized": true,
      "producer": "workflow orchestration",
      "generation": "Generate only when a workflow needs a copyable prompt artifact.",
      "namingConvention": "<run-id>-<lowercase-kebab-case>.md",
      "note": "Prompts are artifacts, not the harness."
    },
    {
      "id": "route-decision",
      "pathPattern": ".ai/runs/<run-id>/route-decision.json",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.prompt-leap-routing.v1",
      "generation": "Create JSON matching shared/schemas/agent-routing/route-decision.schema.json from classifier + router output.",
      "namingConvention": "<run-id>/route-decision.json",
      "validator": "node scripts/ai-harness/validate-harness.mjs"
    },
    {
      "id": "task-demand",
      "pathPattern": ".ai/runs/<run-id>/task-demand.json",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.prompt-leap-routing.v1",
      "generation": "Create JSON matching shared/schemas/agent-routing/task-demand.schema.json from classifier output.",
      "namingConvention": "<run-id>/task-demand.json",
      "validator": "node scripts/ai-harness/validate-harness.mjs"
    },
    {
      "id": "account-backup-certification",
      "pathPattern": ".ai/runs/<run-id>/account-backup-certification.json",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.account-backup-roundtrip-certification.v1",
      "generation": "node scripts/db/run-local-account-backup-cert.mjs",
      "namingConvention": "<run-id>/account-backup-certification.json",
      "schema": ".ai/schemas/account-backup-certification-result.schema.json"
    },
    {
      "id": "account-backup-certification-report",
      "pathPattern": ".ai/runs/<run-id>/account-backup-certification.md",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.account-backup-roundtrip-certification.v1",
      "generation": "Generated beside the machine-readable account backup certification result.",
      "namingConvention": "<run-id>/account-backup-certification.md"
    },
    {
      "id": "predeploy-readiness",
      "pathPattern": ".ai/runs/<run-id>/predeploy-readiness.json",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.predeploy-cost-readiness.v1",
      "generation": "node scripts/ai-harness/evaluate-predeploy-readiness.mjs --input <evidence.json> --output <path>",
      "namingConvention": "<run-id>/predeploy-readiness.json",
      "schema": ".ai/schemas/predeploy-readiness-result.schema.json"
    },
    {
      "id": "stateful-surface-ledger",
      "pathPattern": ".ai/stateful-surface-ledger.json",
      "tracked": true,
      "sanitized": true,
      "producer": "axtask.stateful-architecture-migration.v1",
      "generation": "Update only from repository evidence; provisional decisions fail closed to KEEP. Validate with node scripts/ai-harness/validate-stateful-architecture.mjs.",
      "namingConvention": "stateful-surface-ledger.json",
      "schema": ".ai/stateful-surface-ledger.schema.json",
      "validator": "node scripts/ai-harness/validate-stateful-architecture.mjs"
    },
    {
      "id": "stateful-architecture-report",
      "pathPattern": ".ai/runs/<run-id>/stateful-architecture-report.md",
      "tracked": false,
      "sanitized": true,
      "producer": "axtask.stateful-architecture-migration.v1",
      "generation": "Render .ai/reports/stateful-architecture-report-template.md after a ledger decision or migration seam.",
      "namingConvention": "<run-id>/stateful-architecture-report.md",
      "template": ".ai/reports/stateful-architecture-report-template.md"
    }
  ],
  "forbiddenTrackedOutputs": [
    "raw runtime logs",
    "credentials",
    "database connection values",
    "user exports",
    "personal machine paths",
    "database dumps",
    "heap snapshots",
    "raw Render logs",
    "Playwright output",
    ".ai/runs/ content",
    ".ai/generated/ content"
  ]
}
