    {"id":"local-cert","type":"workflow","path":".ai/workflows/local-deployment-certification.md"},
    {"id":"parallel-intake","type":"workflow","path":".ai/workflows/parallel-sprint-intake.md"},
    {"id":"stateful-architecture-workflow","type":"workflow","path":".ai/workflows/stateful-architecture-migration.md"},
    {"id":"log-retention-contract","type":"contract","path":".ai/log-retention-contract.json"},
    {"id":"log-retention-workflow","type":"workflow","path":".ai/workflows/log-retention-capacity-defense.md"},
    {"id":"agent-workspace-contract","type":"contract","path":".ai/agent-workspace-contract.json"},
    {"id":"agent-workspace-contract-schema","type":"schema","path":".ai/agent-workspace-contract.schema.json"},
    {"id":"agent-workspace-workflow","type":"workflow","path":".ai/workflows/agent-workspace-lifecycle.md"},
    {"id":"run-context","type":"run-context","path":".ai/run-context.schema.json"},
    {"id":"runtime-proof","type":"runtime-proof","path":".ai/runtime-proof.schema.json"},
    {"id":"stateful-surface-ledger-schema","type":"schema","path":".ai/stateful-surface-ledger.schema.json"},
