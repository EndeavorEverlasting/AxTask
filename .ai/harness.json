    {"id":"failure-report","type":"operator-report","path":".ai/reports/failure-report-template.md"},
    {"id":"repo-location-report","type":"operator-report","path":".ai/reports/repository-location-report-template.md"},
    {"id":"stateful-architecture-report","type":"operator-report","path":".ai/reports/stateful-architecture-report-template.md"},
    {"id":"log-retention-report","type":"operator-report","path":".ai/reports/log-retention-report-template.md"},
    {"id":"agent-workspace-report","type":"operator-report","path":".ai/reports/agent-workspace-report-template.md"},
    {"id":"handoff","type":"handoff","path":".ai/handoff/final-handoff-template.md"},
    {"id":"agent-workspace-contract-test","type":"contract-test","path":"server/ai-harness/agent-workspace-contract.test.ts"},
    {"id":"log-retention-ci","type":"ci-workflow","path":".github/workflows/harness-log-retention.yml"},
    {"id":"agent-workspace-ci","type":"ci-workflow","path":".github/workflows/harness-agent-workspaces.yml"},
    {"id":"repo-location-ci","type":"ci-workflow","path":".github/workflows/harness-repo-location.yml"},
    {"id":"pre-commit-hook","type":"local-hook","path":".githooks/pre-commit"},
    {"id":"pre-push-hook","type":"local-hook","path":".githooks/pre-push"}
  ],
  "registryRefs": {
    "workflows": "axtask.workflows.v1",
    "capabilities": "axtask.capabilities.v1",
    "triggers": "axtask.triggers.v1",
    "validators": "axtask.validators.v1",
    "artifacts": "axtask.artifacts.v1",
    "ownership": "axtask.ownership.v1"
  },
  "skills": [
    "axtask.skill.repository-intake.v1",
    "axtask.skill.pr-closeout.v1",
    "axtask.skill.failure-recovery.v1",
    "axtask.skill.harness-maintenance.v1",
    "axtask.skill.runtime-proof.v1",
    "axtask.skill.repository-location-recovery.v1",
    "axtask.skill.stateful-architecture-migration.v1",
    "axtask.skill.log-retention-capacity-defense.v1",
    "axtask.skill.agent-workspace-lifecycle.v1"
  ],
  "readOnlyIntelligence": {
    "id": "axtask.read-only-repo-inspector.v1",
    "command": "node scripts/ai-harness/inspect-repo.mjs",
    "mutationAllowed": false,
    "outputs": ["stdout", ".ai/runs/<run-id>/repo-snapshot.json"]
  },
  "hookPolicy": {
    "automaticInstall": false,
    "installer": "node scripts/ai-harness/install-hooks.mjs",
    "hookPath": ".githooks",
    "runs": ["authority", "harness", "work-queue", "stateful-architecture", "agent-workspaces"],
    "preCommitRuns": ["node-provenance", "node-runtime", "axios-guard", "authority", "harness", "work-queue", "stateful-architecture", "agent-workspaces"],
    "prePushRuns": ["authority", "harness", "harness-infrastructure", "repo-location-recovery", "work-queue", "stateful-architecture", "log-retention", "agent-workspaces", "harness-tests"]
  }
}
