    {"id":"artifacts","type":"artifact-registry","path":".ai/artifact-registry.json"},
    {"id":"validators","type":"validator-registry","path":".ai/validator-registry.json"},
    {"id":"capabilities","type":"capability-registry","path":".ai/capability-registry.json"},
    {"id":"triggers","type":"trigger-registry","path":".ai/trigger-registry.json"},
    {"id":"ownership","type":"ownership-rules","path":".ai/ownership-rules.json"},
    {"id":"contract-impact-registry","type":"contract-impact-registry","path":".ai/contract-impact-registry.json"},
    {"id":"intake-skill","type":"skill","path":".ai/skills/repository-intake.md"},
    {"id":"closeout-skill","type":"skill","path":".ai/skills/pr-closeout.md"},
    {"id":"failure-recovery-skill","type":"skill","path":".ai/skills/failure-recovery.md"},
    {"id":"maintenance-skill","type":"skill","path":".ai/skills/harness-maintenance.md"},
    {"id":"runtime-proof-skill","type":"skill","path":".ai/skills/runtime-proof.md"},
    {"id":"repo-location-skill","type":"skill","path":".ai/skills/repository-location-recovery.md"},
    {"id":"stateful-architecture-skill","type":"skill","path":".ai/skills/stateful-architecture-migration.md"},
    {"id":"log-retention-skill","type":"skill","path":".ai/skills/log-retention-capacity-defense.md"},
    {"id":"agent-workspace-skill","type":"skill","path":".ai/skills/agent-workspace-lifecycle.md"},
    {"id":"harness-infrastructure-validator","type":"validator","path":"scripts/ai-harness/validate-harness-infrastructure.mjs"},
    {"id":"repo-location-resolver","type":"repository-locator","path":"scripts/ai-harness/resolve-checkout.mjs"},
    {"id":"repo-location-validator","type":"validator","path":"scripts/ai-harness/validate-repo-location-recovery.mjs"},
    {"id":"work-queue-validator","type":"validator","path":"scripts/ai-harness/validate-work-queue.mjs"},
    {"id":"stateful-architecture-validator","type":"validator","path":"scripts/ai-harness/validate-stateful-architecture.mjs"},
    {"id":"log-retention-validator","type":"validator","path":"scripts/ai-harness/validate-log-retention.mjs"},
    {"id":"agent-workspace-tool","type":"workspace-lifecycle-tool","path":"scripts/ai-harness/workspaces.mjs"},
    {"id":"agent-workspace-validator","type":"validator","path":"scripts/ai-harness/validate-agent-workspaces.mjs"},
    {"id":"inspector","type":"read-only-intelligence","path":"scripts/ai-harness/inspect-repo.mjs"},
    {"id":"collision-inspector","type":"read-only-intelligence","path":"scripts/ai-harness/inspect-pr-collisions.mjs"},
    {"id":"contract-impact-inspector","type":"read-only-intelligence","path":"scripts/ai-harness/inspect-contract-impact.mjs"},
