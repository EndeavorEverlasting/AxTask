{
  "schemaVersion": 1,
  "authorityRef": "axtask.agent-authority.v1",
  "schemaId": "axtask.stateful-surface-task.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "authorityRef", "surfaceId", "priority", "status", "ownedPaths", "doNot", "artifactPath", "proofCeiling", "evidenceGaps", "validator", "nextCommand"],
  "properties": {
    "schemaVersion": {"const": 1},
    "authorityRef": {"const": "axtask.agent-authority.v1"},
    "surfaceId": {"type": "string", "minLength": 1},
    "priority": {"type": "integer", "minimum": 0},
    "status": {"enum": ["EVIDENCE_REQUIRED", "READY_FOR_DECISION", "BLOCKED", "COMPLETED"]},
    "ownedPaths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "doNot": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifactPath": {"type": "string", "pattern": "^\\.ai/architecture/surfaces/.+\\.json$"},
    "proofCeiling": {"enum": ["contract", "harness", "static-test", "build", "launcher", "command-ack", "behavior-observed", "local-runtime", "live-runtime"]},
    "evidenceGaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "status", "exactFiles", "evidence", "blocker"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "resolved", "blocked"]},
          "exactFiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "finding", "proofLevel"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "finding": {"type": "string", "minLength": 1},
                "proofLevel": {"enum": ["contract", "harness", "static-test", "build", "launcher", "command-ack", "behavior-observed", "local-runtime", "live-runtime"]}
              },
              "additionalProperties": false
            }
          },
          "blocker": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "validator": {"type": "string", "minLength": 1},
    "nextCommand": {"const": "node scripts/ai-harness/next-stateful-task.mjs"}
  },
  "additionalProperties": false
}
