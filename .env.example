#
# Local development defaults (copy to .env)
# This file is safe to commit. Never commit real secrets in .env.
#

NODE_ENV=development
PORT=5000

# Standard CI platform variable (set automatically by GitHub Actions, GitLab CI, etc).
# Used by scripts/apply-migrations.mjs to auto-bypass the migration airlock in CI.
# CI=true


# --- Database target (one active connection string) ---------------------------------
# The app and all DB tools read ONLY the variable name DATABASE_URL (see server/db.ts, drizzle.config.ts).
# It is NOT merged with PORT/SESSION_SECRET/etc. Those are separate keys in this same file.
#
# Use ONE active line. Comment/uncomment to switch, or use a shell-only override for a single command.
#
# Local Postgres (Docker or native) — typical offline dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/axtask
#
# Neon (or other cloud Postgres) — when the host below is up and you want the cloud DB
# (uncomment and comment out the localhost line above; Neon usually needs ?sslmode=require)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Optional: keep a second URL with any name in a COMMENT for copy-paste only — the app does not read it.
# DATABASE_URL is the only name wired in code.
#
# DATABASE_URL must be set at process start (server/db.ts). A wrong host/port yields ECONNREFUSED;
# missing variable exits immediately — that is separate from seed try/catch.

# If Postgres is not running, set to true so npm run dev still skips dev account seeding.
# Other startup seeds in server/routes.ts are wrapped in try/catch and log warnings instead of exiting.
# DISABLE_DEV_SEED=true

# npm run dev — starts the server only (no drizzle-kit push, no migrations/*.sql runner).
# npm run dev:smart — runs scripts/apply-migrations.mjs every time, then db:push when
# shared/schema.ts, drizzle.config.ts, or migrations/*.sql change (see tools/local/offline-start.mjs).
# Full order and diagrams: docs/DEV_DATABASE_AND_SCHEMA.md

# Health: GET /health returns ok if the Node process is up. GET /ready runs SELECT 1 on the pool
# and returns 503 with { status: "not_ready" } if the database is unreachable (useful for orchestration).

# Sessions default to PostgreSQL via connect-pg-simple (see server/auth.ts). The session table is
# created on first use if missing. If Postgres is down after the server has started, routes that touch
# req.session (login, OAuth callback, etc.) can still fail until the database is available.

# Dev only: use in-memory session store so a down Postgres does not break session middleware on first
# request. Sessions do not survive process restart; user lookup/login still requires the database.
# DEV_SESSION_MEMORY_STORE=true

# Required for auth/session signing in local runs
SESSION_SECRET=replace-with-a-32-plus-char-random-secret

# Optional: session + CSRF cookie lifetime in milliseconds (default 604800000 = 7 days).
# SESSION_MAX_AGE_MS=604800000

# --- Registration gating (see server/routes.ts / docs/ENVIRONMENT_VARIABLES.md) ---
# Local dev defaults to "open" so /register works without an invite code.
# Uncomment the two lines below to mirror production (invite-gated) registration.
# REGISTRATION_MODE=invite
# INVITE_CODE=dev-invite-example-change-me

# Optional locally: 64 hex chars (32 bytes) encrypting TOTP secrets at rest. In production, set when using authenticator apps.
# TOTP_ENCRYPTION_KEY=

# --- Google OAuth / auth provider config ---------------------------------------------
# Optional locally. Set in production when Google sign-in or Google-linked auth flows are enabled.
# GOOGLE_CLIENT_ID=


# Keep local host checks dev-friendly
CANONICAL_HOST=localhost
FORCE_HTTPS=false

# --- Archetype empathy analytics (docs/ARCHETYPE_EMPATHY_ANALYTICS.md) ---
# These four vars control the archetype-level analytics pipeline that layers on
# top of the feedback-with-avatars flow. None are required in local dev; the
# pipeline falls back to SESSION_SECRET-derived hashing when ARCHETYPE_ANALYTICS_SALT
# is unset. In production ARCHETYPE_ANALYTICS_SALT is required and fails closed.

# Required in production (>=16 chars; fail-closed). Hashes user ids into an
# opaque hashedActor via HMAC-SHA256 so archetype analytics can never be
# reversed to individuals. Rotating this value breaks Markov continuity.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ARCHETYPE_ANALYTICS_SALT=

# Optional. Scoped token for RAG / analytics services to read
# /api/archetypes/empathy and /api/archetypes/markov without an admin session.
# If unset or empty, only admin-session callers can read.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ARCHETYPE_READ_TOKEN=

# Optional. Background rollup worker tick interval in ms. Default 3600000 (1h).
# ARCHETYPE_ROLLUP_INTERVAL_MS=3600000

# Optional. Set to "true" to disable the background rollup ticker (useful when
# running the rollup via an external scheduler, or during local dev).
# DISABLE_ARCHETYPE_ROLLUP=false

# Optional. Set to 0 to skip the archetype community poll scheduler (no auto-created
# poll windows on startup; engine ensureArchetypePollSchedule is a no-op).
# AXTASK_ARCHETYPE_POLL_SCHEDULER=0

# --- Web Push (VAPID) — optional locally; set on the host for production push delivery --------
# These are separate from DATABASE_URL. Generate all four in one go:
#   npm run vapid:generate -- --subject mailto:you@example.com
# Copy the printed lines here (or from your host dashboard) — never commit real keys.
# VITE_VAPID_PUBLIC_KEY must match VAPID_PUBLIC_KEY and is baked in at "npm run build" time.
# Full table: docs/NOTIFICATIONS_AND_PUSH.md
# Categorized inventory: docs/ENVIRONMENT_VARIABLES.md
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# VITE_VAPID_PUBLIC_KEY=

# --- Backup Fortress / migration airlock ---------------------------------------------
# Optional locally. Leave disabled unless you are actively testing backup automation.
# MIGRATION_SKIP_AIRLOCK=false
# BACKUP_AIRLOCK_RETENTION_HOURS=48
# BACKUP_ENCRYPTION_KEY=
# BACKUP_COMPRESSION_ENABLED=true
# BACKUP_LOCAL_DIR=./backups

# Scheduler / queue modes are mutually exclusive at runtime.
# BACKUP_SCHEDULER_ENABLED=false
# BACKUP_QUEUE_WORKER_ENABLED=false
# BACKUP_BULLMQ_ENABLED=false
# BACKUP_SCHEDULER_INTERVAL_MS=300000
# BACKUP_SCHEDULER_BATCH_SIZE=25
# BACKUP_SCHEDULER_CONCURRENCY=4
# BACKUP_QUEUE_WORKER_POLL_MS=15000
# BACKUP_QUEUE_WORKER_CONCURRENCY=2
# BACKUP_BULLMQ_CONCURRENCY=4

# Optional S3 / object-store targets for backup replication.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=
# BACKUP_S3_TARGETS_JSON=[]

# Optional Redis config for BullMQ-backed backup workers.
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional native alarm companion bridge / client reminder bridges.
# AXTASK_ALARM_COMPANION_URL=http://127.0.0.1:8787/apply-alarm
# AXTASK_ALARM_COMPANION_SECRET=
# VITE_ENABLE_ANDROID_REMINDERS=false
# VITE_ENABLE_WINDOWS_REMINDERS=false

# Optional PG integration test gate used by schema/account-backup tests.
# RUN_PG_SCHEMA_TESTS=0

# Optional bootstrap toggles consumed by tools/local/repo-bootstrap.mjs.
# Set AXTASK_BOOTSTRAP_ALLOW_MISSING_NODEWEAVER=1 to silence the NodeWeaver
# upstream check when the vendored Python tree is intentionally absent.
# Set AXTASK_SKIP_NODEWEAVER_PY=1 to skip the optional `uv sync` step.
# AXTASK_BOOTSTRAP_ALLOW_MISSING_NODEWEAVER=
# AXTASK_SKIP_NODEWEAVER_PY=
